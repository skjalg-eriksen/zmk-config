#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {

        behaviors {
                j_escape_150: j_escape_150 {
                        compatible = "zmk,behavior-tap-dance";
                        #binding-cells = <0>;
                        tapping-term-ms = <150>;
                        bindings = <&kp J>, <&kp ESC>;
                };

                hml: home_row_mod_left {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;

                        flavor = "balanced";
                        tapping-term-ms = <250>;
                        quick-tap-ms = <150>;
                        require-prior-idle-ms = <125>;

                        bindings = <&kp>, <&kp>;

                        hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
                        hold-trigger-on-release;
                };

                hmr: home_row_mod_right {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;

                        flavor = "balanced";
                        tapping-term-ms = <250>;
                        quick-tap-ms = <150>;
                        require-prior-idle-ms = <125>;

                        bindings = <&kp>, <&kp>;

                        hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
                        hold-trigger-on-release;
                };

                lower_shift: lower_shift {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;

                        flavor = "tap-preferred";
                        tapping-term-ms = <200>;
                        quick-tap-ms = <150>;

                        bindings = <&mo>, <&sk>;
                };

                raise_function: raise_function {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;

                        flavor = "tap-preferred";
                        tapping-term-ms = <200>;
                        quick-tap-ms = <150>;

                        bindings = <&mo>, <&sl>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
                            display-name = "Base";
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
// | CTRL | A/ALT | S/CTL | D/GUI | F/SFT | G |   | H | J/SFT | K/GUI | L/CTL | ;/ALT | ' |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | FN   |
//                    | GUI | LWR/SFT | SPC |   | ENT | RSE/FN | ALT |
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp LCTRL &hml LALT A &hml LCTRL S &hml LGUI D &hml LSHFT F &kp G   &kp H &hmr RSHFT J &hmr RGUI K &hmr RCTRL L &hmr RALT SEMI &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &mo 3
                  &kp LGUI &lower_shift 1 LSHFT &kp SPACE   &kp RET &raise_function 2 3 &kp RALT
                        >;
                };
                lower_layer {
                        display-name = "Lower";
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
// | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
// | SHFT | BOOT|     |     |     |     |   |     |     |     |     |     |      |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &kp TAB    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp BSPC
   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
   &kp LSHFT  &bootloader  &trans       &trans       &trans       &trans         &trans   &trans   &trans &trans    &trans &trans
                                    &kp LGUI     &trans       &kp SPACE      &kp RET  &trans   &kp RALT
                        >;
                };

                raise_layer {
                        display-name = "Raise";
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
// | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &kp  TAB  &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
   &studio_unlock &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH &kp GRAVE
   &kp LSHFT &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &kp PIPE &kp TILDE
                             &kp LGUI &trans   &kp SPACE   &kp RET   &trans    &kp RALT
                        >;
                };

                extra1 {
                        display-name = "Function";
// -----------------------------------------------------------------------------------------
// |      |  F1 |  F2 |  F3 |  F4 |  F5 |   |  F6 |  F7 |  F8 |  F9 | F10 |      |
// |      | VDN | VUP | MUT |     |     |   | F11 | F12 |     |     | PSCR|      |
// |      |     |     |     |     |     |   |     |     |     |     |     |      |
//                    |     |     |     |   |     |     |     |
                        bindings = <
   &trans &kp F1  &kp F2   &kp F3 &kp F4 &kp F5   &kp F6  &kp F7  &kp F8 &kp F9 &kp F10  &trans
   &trans &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE &trans &trans   &kp F11 &kp F12 &trans &trans &kp PSCRN &trans
   &trans  &trans  &trans   &trans &trans &trans   &trans &trans &trans &trans &trans   &trans
                            &trans &trans &trans   &trans &trans &trans
                        >;
                };

                extra2 {
                        display-name = "Extra-2";
                        status = "reserved";
                };

                extra3 {
                        display-name = "Extra-3";
                        status = "reserved";
                };
        };
};
